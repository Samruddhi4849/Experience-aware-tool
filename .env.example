# Copy this file to ".env" and fill in values if you want LIVE MODE.
# The app runs completely fine WITHOUT any keys, in DEMO MODE.

# Execution mode: "demo" or "live". Demo mode needs no keys at all.
EXECUTION_MODE=demo

# Optional. Only used in LIVE MODE for LLM-assisted reasoning.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Only used in LIVE MODE by the real Weather tool.
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional. Only used in LIVE MODE by the real Currency tool.
# Get a free key at https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=

# Local storage paths (defaults are fine for most users)
SQLITE_DB_PATH=data/experiences.db
CHROMA_PERSIST_DIR=data/chroma_store
